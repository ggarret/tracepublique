# Valeurs locales fictives uniquement. Ne jamais y placer un secret réel.
# Connexion PostgreSQL locale utilisée par Prisma et l'API NestJS.
DATABASE_URL=postgresql://observatoire:observatoire_dev@localhost:5432/observatoire?schema=public

# NestJS API settings.
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# Public repository URL displayed in the site header, footer and About page.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ggarret/tracepublique

# Canonical public URL used by metadata, robots.txt, sitemap.xml and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local domain used by the generic Caddy configuration when needed.
SITE_DOMAIN=localhost
